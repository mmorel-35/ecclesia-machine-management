"""Ecclesia Machine Management bzlmod configuration.

This MODULE.bazel enables bzlmod support for the Ecclesia project while
maintaining full backward compatibility with WORKSPACE mode.

USAGE:
------
1. WORKSPACE mode (default, full compatibility):
   bazel build //...

2. Bzlmod hybrid mode (recommended for bzlmod):
   bazel build --enable_bzlmod --enable_workspace //...
   
   This uses MODULE.bazel for available dependencies and falls back to
   WORKSPACE for dependencies with custom patches/builds.

3. Pure bzlmod mode (limited support):
   bazel build --enable_bzlmod --noenable_workspace //...
   
   Only uses MODULE.bazel. Many dependencies not yet available without WORKSPACE.

STRATEGY:
---------
This project has 40+ dependencies, many with:
- Custom patches applied via patch_args
- Custom BUILD files for external projects
- Specific version requirements
- Complex transitive dependency chains (TensorFlow, gRPC, etc.)

For bzlmod support, we declare dependencies available in Bazel Central Registry
(BCR) and rely on WORKSPACE for the rest via --enable_workspace flag.

A full bzlmod-only migration would require:
- Converting all patches to standalone patch files
- Creating BUILD files for all external dependencies in the repository
- Resolving version conflicts with BCR modules
- Extensive testing of the complex dependency graph
"""

module(
    name = "ecclesia-machine-management",
    version = "1.0",
    repo_name = "com_google_ecclesia",
)

# ============================================================================
# Core Bazel rules from Bazel Central Registry
# ============================================================================

bazel_dep(name = "bazel_skylib", version = "1.4.2")
bazel_dep(name = "platforms", version = "0.0.8")
bazel_dep(name = "rules_cc", version = "0.0.9")
bazel_dep(name = "rules_proto", version = "5.3.0-21.7")
bazel_dep(name = "rules_python", version = "0.26.0")
bazel_dep(name = "rules_pkg", version = "0.9.1")

# Protocol Buffers - using version 29.1 which is compatible with Bazel 7.x
bazel_dep(name = "protobuf", version = "29.1", repo_name = "com_google_protobuf")

# ============================================================================
# C++ Core Libraries - Native Bazel projects available in BCR
# ============================================================================

# Abseil - C++ common libraries
bazel_dep(name = "abseil-cpp", version = "20230802.2", repo_name = "com_google_absl")

# GoogleTest - C++ testing framework
bazel_dep(name = "googletest", version = "1.14.0", repo_name = "com_google_googletest")

# Google Benchmark - C++ microbenchmarking library
bazel_dep(name = "google_benchmark", version = "1.8.3", repo_name = "com_github_google_benchmark")

# RE2 - Regular expression library
bazel_dep(name = "re2", version = "2023-09-01", repo_name = "com_googlesource_code_re2")

# zlib - Compression library
bazel_dep(name = "zlib", version = "1.3.1")

# Python toolchain configuration
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.11",
)

